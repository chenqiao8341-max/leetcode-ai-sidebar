{
  "manifest_version": 3,
  "name": "力扣伴读 · AI Sidebar",
  "version": "0.6.2",
  "description": "DeepSeek Agent 结合力扣题目修改代码、运行用例或提交判题，支持状态查询、超时与页面诊断。",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.cn/*",
    "https://leetcode.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开力扣伴读"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.cn/problems/*",
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.cn/problems/*",
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "test-tools.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: http://127.0.0.1:* http://localhost:*"
  }
}
